-# frozen_string_literal: true
- dims = jpg_dimensions(image)
%figure.imageholder{image_frame_attrs(dims)}
  = link_to localized_image_url(image, locale: locale || nil) do
    = image_tag(jpg_url(image), dimension_attrs(dims))
  %figcaption.imagetitle
    = link_to localized_image_url(image, locale: locale || nil), class: "not-green" do
      = image.decorated.title
