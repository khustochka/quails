-# frozen_string_literal: true
- @robots ||= "NOINDEX"

- @page_title = capture do
  - if params[:month]
    - title_key = params[:year] ? "yearmonthlist" : "monthlist"
    - month_title = t("lifelist.title.#{title_key}", month: t("date.common_month_names")[params[:month].to_i], year: params[:year])
    = [month_title, params[:locus] ? "(#{@lifelist.locus.name})" : nil].compact.join(" ")
  - elsif params[:year]
    = [t("lifelist.title.yearlist", year: params[:year]), params[:locus] ? "(#{@lifelist.locus.name})" : nil].join(" ")
  - elsif @lifelist.locus.is_a?(PlaceholderCountry)
    -# No DB row for this hardcoded country: its name is already the full title phrase.
    = @lifelist.locus.name
  - elsif params[:locus]
    - if @lifelist.locus.country?
      = t("lifelist.title.countrylist", country: @lifelist.locus.name)
    - else
      = t("lifelist.title.locationlist", location: @lifelist.locus.name)
  - else
    = t("lifelist.title.lifelist")
  = lifelist_filter_title_suffix

- content_for :translated do
  = render "app2/shared/translated"

-# A month combined with any other filter multiplies into too many pages to cache.
- do_not_cache = params[:month] && (params[:locus] || params[:sort] || params[:year] || lifelist_filters_active?)
- cache_unless do_not_cache, amended_params(admin: current_user.admin?, key: Quails::CacheKey.lifelist, locale: I18n.locale) do
  .page-container.lifelist-page

    = content_for :translated

    = simple_page_header(page_header)

    = render "lifelist/basic/filters"

    - if @lifelist.blank?
      %ul.lifelist-empty.p-0.m-0.text-gray-500
        %li= t("lifelist.basic.no_species")
    - elsif params[:sort] == "taxonomy"
      = render "lifelist/basic/taxonomy"
    - else
      = render "lifelist/basic/date"
