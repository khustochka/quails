-# frozen_string_literal: true
-# Year / region / sort filter bar for the basic lifelist (app2 layout).
-# Pulled up towards the page header, which carries a large bottom margin.
%nav.lifelist-filters.-mt-2.md:-mt-6.mb-10
  %ul.p-0.m-0
    - if @lifelist.years.present?
      = lifelist_filter_row(t("filters.years.years")) do
        - @lifelist.years.each do |year|
          -# A nil year is the "all years" entry.
          %li= lifelist_filter_option(year || t("misc.all"), :year, year)

    = lifelist_filter_row(t("lifelist.basic.filter.month")) do
      %li= lifelist_filter_option(t("misc.all"), :month, nil)
      - 1.upto(12) do |month|
        %li= lifelist_filter_option(t("date.abbr_month_names")[month], :month, month)

    = lifelist_filter_row(t("lifelist.basic.filter.region")) do
      %li= lifelist_filter_option(t("misc.all"), :locus, nil)
      - @countries.each do |loc|
        %li= lifelist_filter_option(loc.name, :locus, loc.slug)
      - if @regions.present?
        -# `details` is collapsed by default, and stays open while one of the
        -# regions inside it is the active filter. Text browsers that do not
        -# support it simply show every region.
        %li.filter-more
          %details{open: @regions.any? { |loc| loc.slug == params[:locus] }}
            %summary
              %span= t("lifelist.basic.filter.more_regions")
            %ul.filter-options{class: LifelistHelper::FILTER_OPTIONS_CLASSES}
              - @regions.each do |loc|
                %li= lifelist_filter_option(loc.name, :locus, loc.slug)

    - if @lifelist.present?
      = lifelist_filter_row(t("lifelist.basic.filter.sort_by")) do
        - [nil, :taxonomy].each do |sort|
          %li= lifelist_sort_option(sort)
        - advanced_url = significant_params.slice(:year, :month, :locus).merge(action: :advanced)
        %li.filter-advanced.ml-1= link_to(t("lifelist.menus.advanced"), advanced_url, class: "advanced")
