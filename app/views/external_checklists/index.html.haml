-# frozen_string_literal: true
- stylesheet "forms"

- @page_title = "External Checklists"

= render "admin/shortcuts"

%h1= page_header

- if notice
  %p= notice

= button_to "Request preload", preload_external_checklists_path,
            method: :post, remote: true, class: "button",
            form: {data: {external_checklists_preload: true}}

%p{data: {external_checklists_status: true}, "aria-live": "polite"}

%div{data: {external_checklists: true}}
  = render "list", checklists: @checklists, loci: @loci
