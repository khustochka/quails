-# frozen_string_literal: true
- stylesheet "forms"

- @page_title = "Import checklists"

%h1= page_header

- provide :add_shortcuts do
  %li= link_to "Export to eBird", ebird_submissions_path

= render "admin/shortcuts"

- if notice
  %p= notice
- if alert
  %p= alert

= button_to "Request preload", preload_imports_path,
            method: :post, remote: true, class: "button",
            form: {data: {external_checklists_preload: true}}

%p{data: {external_checklists_status: true}, "aria-live": "polite"}

%div{data: {external_checklists: true}}
  = render "list", checklists: @checklists, loci: @loci, last_preload_at: @last_preload_at
