-# frozen_string_literal: true
%footer.page_footer{role: "contentinfo"}
  -# Text browsers draw this rule where CSS gives sighted users the border-top.
  %hr.footer-rule{"aria-hidden" => "true"}
  .footer-inner{class: ("footer-inner-compact" if hide_footer_links?)}
    - unless hide_footer_links?
      %h2#footer-nav-heading.sr-only= t("footer.nav_label")
      = render "shared/footer/links"
    .footer-text
      .footer-credits
        %p.footer-attribution
          = succeed "," do
            = t("author.name")
          2007&ndash;#{Quails::LICENSE_YEAR}
        %p.footer-license
          = t("license.text", link: "https://creativecommons.org/licenses/by-nc-sa/4.0/").html_safe
      - unless hide_footer_banner?
        -# Template Dependency: partials/birdingtop_code
        .footer-banner= include_birdingtop_button
