-# frozen_string_literal: true
- @body_class = "map-page"
- @page_title = t(".title")

- content_for :head do
  - if ENV["GOOGLE_MAPS_API_KEY"]
    = tag.meta name: "google-maps-api-key", content: ENV["GOOGLE_MAPS_API_KEY"]

  = javascript_include_tag "admin-maps", defer: true

- ramp = MapHelper::INTENSITY_RAMP

.mapContainer
  #googleMap{data: {map_enabled: map_enabled, map_mode: "map-global",
                    summary_label: t(".summary", species: "%{species}", cards: "%{cards}"),
                    lifelist_label: t(".lifelist"),
                    lifelist_url: advanced_list_path,
                    ramp: ramp.join(",")}}
  .map-legend
    %h2= t(".legend_title")
    %ul
      - ramp.each do |color|
        %li{style: "background-color: #{color}"}
    .map-legend-scale
      %span= t(".legend_fewer")
      %span= t(".legend_more")
